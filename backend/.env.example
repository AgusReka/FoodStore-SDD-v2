# Database Configuration
# PostgreSQL connection string (user:password@host:port/database)
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db

# JWT Security Configuration
# Key for JWT token signing (minimum 32 characters long)
SECRET_KEY=your-secret-key-minimum-32-characters-long
# JWT signing algorithm (default HS256)
ALGORITHM=HS256
# JWT access token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token expiration time in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
# Allowed origins for CORS (JSON array format)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Frontend URL (for email links - password reset, email verification)
FRONTEND_URL=http://localhost:5173

# Mercado Pago Configuration
# Access Token (TEST or PROD) from Mercado Pago dashboard — https://developers.mercadopago.com
# This is the main credential for the MP SDK backend integration.
MERCADOPAGO_ACCESS_TOKEN=TEST-123456789-abcdef
# Public Key from Mercado Pago dashboard — used by the frontend SDK to initialize Wallet Brick.
# This is a public value (safe to expose in frontend code).
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Webhook secret for X-Signature verification (configured in MP dashboard > Webhooks).
# Optional in development — leave empty to skip signature validation.
MERCADOPAGO_WEBHOOK_SECRET=
# Public URL for IPN notifications — MUST be internet-accessible.
# Local dev: use ngrok (ngrok http 8000) and paste the URL here.
# Production: your domain + path.
MERCADOPAGO_WEBHOOK_URL=http://localhost:8000/api/v1/pagos/mercadopago/webhook


MP_USER_TEST=TESTUSER3235388490070266374
MP_USER_PASS=cd3L7hY12A
# Email / SMTP Configuration (optional in development)
# Leave MAIL_HOST commented/unset to use console-only dev mode (tokens printed to stdout)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=noreply@foodstore.com
# MAIL_STARTTLS=true
# MAIL_SSL_TLS=false