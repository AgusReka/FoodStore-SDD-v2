# Database Configuration
# PostgreSQL connection string (user:password@host:port/database)
DATABASE_URL=postgresql://user:pass@localhost:5432/foodstore_db

# JWT Security Configuration
# Key for JWT token signing (minimum 32 characters long)
SECRET_KEY=your-secret-key-minimum-32-characters-long
# JWT signing algorithm (default HS256)
ALGORITHM=HS256
# JWT access token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token expiration time in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
# Allowed origins for CORS (JSON array format)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# MercadoPago Configuration
# MercadoPago access token from dashboard
MP_ACCESS_TOKEN=TEST-xxxx
# MercadoPago public key (exposed to frontend)
MP_PUBLIC_KEY=TEST-xxxx
# Webhook URL for payment notifications
MP_NOTIFICATION_URL=https://your-domain.com/api/v1/pagos/webhook